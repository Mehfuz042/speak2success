# Copy this file to backend/.env and fill in your values.
# backend/.env is git-ignored - never commit real secrets.

# Flask port (default 5000).
PORT=5000

# Comma-separated origins allowed to call the API (dev: Vite).
ALLOWED_ORIGINS=http://localhost:5173

# Google Gemini API key - used from Phase 2 (question generation + feedback).
GEMINI_API_KEY=

# Where sessions/reports are persisted (SQLite). Omit for an in-memory store.
# STORAGE_PATH=backend/data/speak2success.sqlite3
